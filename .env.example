# Pitch Machine API base URL. Leave as the default unless you're pointing
# at a staging environment or a self-hosted deployment.
PITCHMACHINE_API_BASE=https://pitchmachine.ai

# Long-lived API token for your Pitch Machine account.
#
# v0 accepts a Supabase session JWT — grab it from the browser DevTools
# after signing in at https://pitchmachine.ai. Application → Local Storage
# → sb-<project>-auth-token → paste the "access_token" value here.
#
# A proper API-token surface is on the roadmap; see the /agents page on
# pitchmachine.ai for the current story.
PITCHMACHINE_API_TOKEN=

# Optional: default per-request timeout in milliseconds. Defaults to 30000.
# The generate-pitch tool has its own longer polling budget.
# PITCHMACHINE_REQUEST_TIMEOUT_MS=30000
